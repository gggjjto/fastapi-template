{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "@rapid-template/api#build": {
      "outputs": []
    },
    "@rapid-template/config#build": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**", "coverage.xml"]
    },
    "@rapid-template/api#test": {
      "outputs": []
    },
    "@rapid-template/config#test": {
      "outputs": []
    },
    "@rapid-template/web#test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
